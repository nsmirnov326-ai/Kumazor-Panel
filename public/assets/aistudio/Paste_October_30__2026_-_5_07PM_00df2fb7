import asyncio
from aiogram import Bot, Dispatcher, types
from app.config import BOT_TOKEN, ALLOWED_CHAT_IDS
from app.parser import parse_ba_message
from app.scraper import fetch_full_text
from app.database import AsyncSessionLocal, Publication
from sqlalchemy import select

bot = Bot(token=BOT_TOKEN) if BOT_TOKEN else None
dp = Dispatcher()

@dp.message()
async def handle_incoming(message: types.Message):
    if ALLOWED_CHAT_IDS and message.chat.id not in ALLOWED_CHAT_IDS:
        return

    text = message.text or message.caption or ""
    if "Brand Analytics" not in text and "персонального фильтра" not in text:
        return

    # Извлечение скрытых ссылок из Entities Telegram
    parsed = parse_ba_message(text)
    if not parsed["post_url"]:
        # Fallback на entities если ссылки были скрыты
        if message.entities:
            for ent in message.entities:
                if ent.type == "text_link" and ent.url:
                    if "/t.me/" in ent.url or "telegram.me/" in ent.url:
                        if not parsed["post_url"]:
                            parsed["post_url"] = ent.url

    if not parsed["post_url"]:
        return

    # Забор полного текста
    full_text = await fetch_full_text(parsed["post_url"], parsed["snippet_text"])

    async with AsyncSessionLocal() as session:
        # Проверка на дубликаты
        exist = await session.execute(select(Publication).where(Publication.post_url == parsed["post_url"]))
        if exist.scalar_one_or_none():
            return

        pub = Publication(
            filter_name=parsed["filter_name"],
            network=parsed["network"],
            author_name=parsed["author_name"],
            author_url=parsed["author_url"],
            post_url=parsed["post_url"],
            audience=parsed["audience"],
            published_at=parsed["published_at"],
            snippet_text=parsed["snippet_text"],
            full_text=full_text
        )
        session.add(pub)
        await session.commit()
