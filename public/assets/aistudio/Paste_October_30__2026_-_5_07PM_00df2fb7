import asyncio
from fastapi import FastAPI, Depends, Query, Response
from fastapi.staticfiles import StaticFiles
from fastapi.responses import FileResponse
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select, desc, or_, and_
from contextlib import asynccontextmanager
import pandas as pd
import io

from app.database import init_db, AsyncSessionLocal, Publication
from app.bot import bot, dp
from app.config import BOT_TOKEN

@asynccontextmanager
async def lifespan(app: FastAPI):
    await init_db()
    bot_task = None
    if bot:
        bot_task = asyncio.create_task(dp.start_polling(bot))
    yield
    if bot_task:
        bot_task.cancel()

app = FastAPI(title="Brand Analytics Dashboard", lifespan=lifespan)
app.mount("/static", StaticFiles(directory="static"), name="static")

async def get_db():
    async with AsyncSessionLocal() as session:
        yield session

@app.get("/")
def read_index():
    return FileResponse("static/index.html")

@app.get("/api/posts")
async def get_posts(
    q: str = Query(None),
    author: str = Query(None),
    filter_name: str = Query(None),
    min_aud: int = Query(None),
    limit: int = 50,
    offset: int = 0,
    db: AsyncSession = Depends(get_db)
):
    stmt = select(Publication).order_by(desc(Publication.published_at))
    conditions = []

    if q:
        words = q.strip().split()
        for w in words:
            if w.startswith("-") and len(w) > 1:
                conditions.append(~Publication.full_text.ilike(f"%{w[1:]}%"))
            else:
                conditions.append(Publication.full_text.ilike(f"%{w}%"))
    if author:
        conditions.append(Publication.author_name == author)
    if filter_name:
        conditions.append(Publication.filter_name == filter_name)
    if min_aud:
        conditions.append(Publication.audience >= min_aud)

    if conditions:
        stmt = stmt.where(and_(*conditions))

    result = await db.execute(stmt.limit(limit).offset(offset))
    items = result.scalars().all()
    return items

@app.get("/api/filters-meta")
async def get_filters_meta(db: AsyncSession = Depends(get_db)):
    authors = await db.execute(select(Publication.author_name).distinct())
    filters = await db.execute(select(Publication.filter_name).distinct())
    return {
        "authors": [a[0] for a in authors.fetchall() if a[0]],
        "filters": [f[0] for f in filters.fetchall() if f[0]]
    }

@app.get("/api/export")
async def export_excel(q: str = None, author: str = None, db: AsyncSession = Depends(get_db)):
    stmt = select(Publication).order_by(desc(Publication.published_at))
    conditions = []
    if q:
        conditions.append(Publication.full_text.ilike(f"%{q}%"))
    if author:
        conditions.append(Publication.author_name == author)
    if conditions:
        stmt = stmt.where(and_(*conditions))

    result = await db.execute(stmt.limit(2000))
    records = result.scalars().all()

    df = pd.DataFrame([{
        "Дата": r.published_at.strftime("%Y-%m-%d %H:%M"),
        "Сеть": r.network,
        "Автор": r.author_name,
        "Аудитория": r.audience,
        "Фильтр BA": r.filter_name,
        "Ссылка на пост": r.post_url,
        "Полный текст": r.full_text
    } for r in records])

    output = io.BytesIO()
    with pd.ExcelWriter(output, engine="openpyxl") as writer:
        df.to_excel(writer, index=False, sheet_name="Мониторинг")
    output.seek(0)

    headers = {"Content-Disposition": 'attachment; filename="monitoring_export.xlsx"'}
    return Response(content=output.getvalue(), media_type="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", headers=headers)
