  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen flex flex-col font-sans">

  <!-- Header -->
  <header class="bg-gray-800 border-b border-gray-700 px-6 py-4 flex flex-wrap items-center justify-between gap-4 sticky top-0 z-50">
    <div class="flex items-center gap-3">
      <i class="fa-solid fa-radar text-blue-500 text-2xl"></i>
      <h1 class="text-xl font-bold tracking-tight">BA Dashboard</h1>
    </div>

    <!-- Toggle Modes -->
    <div class="flex items-center bg-gray-900 p-1 rounded-lg border border-gray-700">
      <button id="feedModeBtn" onclick="setMode('feed')" class="px-4 py-1.5 rounded-md text-sm font-medium bg-blue-600 text-white transition">
        <i class="fa-solid fa-bars-staggered mr-2"></i>Лента
      </button>
      <button id="tableModeBtn" onclick="setMode('table')" class="px-4 py-1.5 rounded-md text-sm font-medium text-gray-400 hover:text-white transition">
        <i class="fa-solid fa-table mr-2"></i>Таблица
      </button>
    </div>

    <!-- Export Button -->
    <button onclick="exportExcel()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg text-sm font-medium flex items-center gap-2 transition">
      <i class="fa-solid fa-file-excel"></i> Экспорт в Excel
    </button>
  </header>

  <!-- Filter Bar -->
  <div class="bg-gray-800/60 backdrop-blur border-b border-gray-700/60 px-6 py-3 flex flex-wrap gap-3 items-center">
    <div class="flex-1 min-w-[280px] relative">
      <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-gray-400"></i>
      <input type="text" id="searchInput" onkeydown="if(event.key==='Enter') loadData()" placeholder="Поиск (слова, фразы, -минус)..." 
             class="w-full bg-gray-900 border border-gray-700 rounded-lg pl-10 pr-4 py-2 text-sm focus:outline-none focus:border-blue-500">
    </div>

    <select id="authorSelect" onchange="loadData()" class="bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-sm focus:outline-none">
      <option value="">Все авторы</option>
    </select>

    <select id="filterSelect" onchange="loadData()" class="bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-sm focus:outline-none">
      <option value="">Все фильтры BA</option>
    </select>

    <input type="number" id="minAudInput" onchange="loadData()" placeholder="Мин. аудитория" 
           class="w-36 bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-sm focus:outline-none">

    <button onclick="loadData()" class="bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg text-sm font-medium">Найти</button>
  </div>

  <!-- Content Container -->
  <main class="flex-1 p-6 max-w-7xl w-full mx-auto">
    <!-- FEED VIEW -->
    <div id="feedView" class="space-y-4"></div>

    <!-- TABLE VIEW -->
    <div id="tableView" class="hidden overflow-x-auto bg-gray-800 border border-gray-700 rounded-xl">
      <table class="w-full text-left text-sm">
        <thead class="bg-gray-900/80 text-gray-400 border-b border-gray-700">
          <tr>
            <th class="p-3">Дата</th>
            <th class="p-3">Автор</th>
            <th class="p-3">Охват</th>
            <th class="p-3">Текст (превью)</th>
            <th class="p-3">Ссылка</th>
          </tr>
        </thead>
        <tbody id="tableBody" class="divide-y divide-gray-700/60"></tbody>
      </table>
    </div>
  </main>

  <!-- Modal for Full Text in Table Mode -->
  <div id="textModal" class="fixed inset-0 bg-black/70 hidden items-center justify-center p-4 z-50">
    <div class="bg-gray-800 border border-gray-700 rounded-xl max-w-2xl w-full p-6 space-y-4 max-h-[85vh] flex flex-col">
      <div class="flex justify-between items-center border-b border-gray-700 pb-3">
        <h3 id="modalTitle" class="font-bold text-lg text-blue-400"></h3>
        <button onclick="closeModal()" class="text-gray-400 hover:text-white text-xl">&times;</button>
      </div>
      <div id="modalContent" class="overflow-y-auto whitespace-pre-wrap text-gray-200 text-sm leading-relaxed"></div>
      <div class="text-right">
        <a id="modalLink" target="_blank" class="text-blue-400 hover:underline text-sm font-medium">Перейти к оригиналу &rarr;</a>
      </div>
    </div>
  </div>

  <script>
    let currentMode = 'feed';
    let postsData = [];

    function setMode(mode) {
      currentMode = mode;
      document.getElementById('feedView').classList.toggle('hidden', mode !== 'feed');
      document.getElementById('tableView').classList.toggle('hidden', mode !== 'table');

      document.getElementById('feedModeBtn').className = mode === 'feed' 
        ? "px-4 py-1.5 rounded-md text-sm font-medium bg-blue-600 text-white transition"
        : "px-4 py-1.5 rounded-md text-sm font-medium text-gray-400 hover:text-white transition";

      document.getElementById('tableModeBtn').className = mode === 'table' 
        ? "px-4 py-1.5 rounded-md text-sm font-medium bg-blue-600 text-white transition"
        : "px-4 py-1.5 rounded-md text-sm font-medium text-gray-400 hover:text-white transition";

      render();
    }

    async function loadMeta() {
      const res = await fetch('/api/filters-meta');
      const data = await res.json();
      const aSel = document.getElementById('authorSelect');
      const fSel = document.getElementById('filterSelect');
      data.authors.forEach(a => aSel.innerHTML += `<option value="${a}">${a}</option>`);
      data.filters.forEach(f => fSel.innerHTML += `<option value="${f}">${f}</option>`);
    }

    async function loadData() {
      const q = document.getElementById('searchInput').value;
      const author = document.getElementById('authorSelect').value;
      const filter_name = document.getElementById('filterSelect').value;
      const min_aud = document.getElementById('minAudInput').value;

      const params = new URLSearchParams();
      if(q) params.append('q', q);
      if(author) params.append('author', author);
      if(filter_name) params.append('filter_name', filter_name);
      if(min_aud) params.append('min_aud', min_aud);

      const res = await fetch('/api/posts?' + params.toString());
      postsData = await res.json();
      render();
    }

    function render() {
      if(currentMode === 'feed') renderFeed();
      else renderTable();
    }

    function renderFeed() {
      const c = document.getElementById('feedView');
      if(!postsData.length) {
        c.innerHTML = '<div class="text-center py-12 text-gray-500">Нет публикаций по заданным критериям</div>';
        return;
      }
      c.innerHTML = postsData.map(p => `
        <article class="bg-gray-800 border border-gray-700 rounded-xl p-5 shadow-lg space-y-3">
          <div class="flex items-center justify-between flex-wrap gap-2 text-xs border-b border-gray-700/60 pb-3">
            <div class="flex items-center gap-2">
              <span class="bg-blue-900/60 text-blue-300 font-semibold px-2 py-0.5 rounded border border-blue-700/40">${p.network}</span>
              <a href="${p.author_url}" target="_blank" class="font-bold text-gray-200 hover:text-blue-400 text-sm">${p.author_name}</a>
              <span class="text-gray-400">👥 ${Number(p.audience).toLocaleString('ru-RU')}</span>
            </div>
            <div class="text-gray-400 flex items-center gap-3">
              <span>Фильтр: <b class="text-gray-300">${p.filter_name}</b></span>
              <span>${new Date(p.published_at).toLocaleString('ru-RU')}</span>
            </div>
          </div>
          <div class="text-gray-200 text-sm whitespace-pre-wrap leading-relaxed">${p.full_text}</div>
          <div class="pt-2 text-right">
            <a href="${p.post_url}" target="_blank" class="text-xs text-blue-400 hover:underline">Открыть публикацию &rarr;</a>
          </div>
        </article>
      `).join('');
    }

    function renderTable() {
      const b = document.getElementById('tableBody');
      if(!postsData.length) {
        b.innerHTML = '<tr><td colspan="5" class="text-center py-8 text-gray-500">Нет публикаций</td></tr>';
        return;
      }
      b.innerHTML = postsData.map((p, idx) => `
        <tr class="hover:bg-gray-700/40 transition">
          <td class="p-3 text-xs text-gray-400 whitespace-nowrap">${new Date(p.published_at).toLocaleDateString('ru-RU')} ${new Date(p.published_at).toLocaleTimeString('ru-RU', {hour:'2-digit', minute:'2-digit'})}</td>
          <td class="p-3 font-medium text-gray-200">${p.author_name}</td>
          <td class="p-3 text-xs text-gray-300 whitespace-nowrap">👥 ${Number(p.audience).toLocaleString('ru-RU')}</td>
          <td class="p-3 text-xs text-gray-400 max-w-md truncate cursor-pointer hover:text-blue-300" onclick="openModal(${idx})">
            ${p.full_text.substring(0, 140)}...
          </td>
          <td class="p-3 text-xs whitespace-nowrap">
            <a href="${p.post_url}" target="_blank" class="text-blue-400 hover:underline">Перейти</a>
          </td>
        </tr>
      `).join('');
    }

    function openModal(idx) {
      const p = postsData[idx];
      document.getElementById('modalTitle').innerText = `${p.author_name} (${p.network})`;
      document.getElementById('modalContent').innerText = p.full_text;
      document.getElementById('modalLink').href = p.post_url;
      document.getElementById('textModal').classList.remove('hidden');
      document.getElementById('textModal').classList.add('flex');
    }

    function closeModal() {
      document.getElementById('textModal').classList.add('hidden');
      document.getElementById('textModal').classList.remove('flex');
    }

    function exportExcel() {
      const q = document.getElementById('searchInput').value;
      const author = document.getElementById('authorSelect').value;
      window.location.href = `/api/export?q=${encodeURIComponent(q)}&author=${encodeURIComponent(author)}`;
    }

    loadMeta();
    loadData();
  </script>
</body>
</html>
```
Где скачать и как развернуть (Инструкция)
Шаг 1. Создайте файлы на вашем сервере
Подключитесь к вашему VPS/серверу по SSH:
codeBash
```
mkdir -p ba-monitor/app ba-monitor/static
cd ba-monitor
```
Скопируйте код каждого файла в соответствующие пути (можно использовать редактор nano или скопировать папку через SFTP / FileZilla).
Шаг 2. Настройте Telegram-бота
1. Перейдите в Telegram к @BotFather и создайте бота (/newbot), получите токен.
2. Откройте docker-compose.yml и вставьте ваш токен в переменную:
  codeYaml
  BOT_TOKEN: "123456789:ABCdefGhIJKlmNoPQRstuVWXyz"
3. Добавьте бота в чат/группу, куда Brand Analytics присылает алерты (дайте боту права администратора на чтение сообщений).
Шаг 3. Запуск
В папке ba-monitor выполните:
codeBash
```
docker compose up -d --build
```
Шаг 4. Готово!
* Откройте браузер по адресу: http://IP_ВАШЕГО_СЕРВЕРА:8080.
* По мере поступления алертов бот парсит их, выкачивает полные тексты постов и сразу наполняет базу данных. В веб-панели вам доступны оба режима («Лента» и «Таблица»), поиск и экспорт в Excel.
