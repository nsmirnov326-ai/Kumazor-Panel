import httpx
from bs4 import BeautifulSoup

async def fetch_full_text(url: str, fallback_snippet: str) -> str:
    """
    Скачивает 100% текста публикации через публичный embed Telegram,
    минуя блокировки и ограничения.
    """
    if "t.me/" not in url and "telegram.me/" not in url:
        return fallback_snippet

    embed_url = url.replace("telegram.me/", "t.me/")
    if not embed_url.endswith("?embed=1"):
        embed_url += "?embed=1"

    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    }

    try:
        async with httpx.AsyncClient(timeout=6.0, follow_redirects=True) as client:
            resp = await client.get(embed_url, headers=headers)
            if resp.status_code == 200:
                soup = BeautifulSoup(resp.text, "html.parser")
                text_div = soup.find("div", class_="tgme_widget_message_text")
                if text_div:
                    for br in text_div.find_all("br"):
                        br.replace_with("\n")
                    text = text_div.get_text().strip()
                    if len(text) > len(fallback_snippet.replace("...", "")):
                        return text
    except Exception as e:
        print(f"[Scraper Error] {url}: {e}")

    return fallback_snippet
