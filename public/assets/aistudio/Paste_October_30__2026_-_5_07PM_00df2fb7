import re
from datetime import datetime

def parse_ba_message(text: str, entities: list = None) -> dict:
    """
    Парсит структуру типового сообщения Brand Analytics,
    извлекая все параметры, включая ссылки из markdown/entities.
    """
    data = {
        "filter_name": "Общий",
        "audience": 0,
        "network": "telegram.org",
        "post_url": "",
        "published_at": datetime.utcnow(),
        "author_name": "Неизвестный автор",
        "author_url": "",
        "snippet_text": ""
    }

    # 1. Фильтр и аудитория в шапке
    filt_m = re.search(r'персонального фильтра\s*["«]([^"»]+)["»]', text)
    if filt_m:
        data["filter_name"] = filt_m.group(1).strip()

    aud_m = re.search(r'(?:аудиторией|👥)\s*([\d\s]+)', text)
    if aud_m:
        data["audience"] = int(re.sub(r'\s+', '', aud_m.group(1)))

    # 2. Сеть, пост URL и дата
    # Пример: Пост в telegram.org (https://telegram.me/UstKutNet/28837) | 27.10.2026  13:24 (UTC+3)
    post_m = re.search(r'Пост в\s+([^\s\(]+)\s*\((https?://[^\)]+)\)\s*\|\s*([\d\.\s\:]+)', text)
    if post_m:
        data["network"] = post_m.group(1).strip()
        data["post_url"] = post_m.group(2).strip()
        raw_dt = post_m.group(3).strip()
        try:
            # Очистка двойных пробелов между датой и временем
            raw_dt = re.sub(r'\s+', ' ', raw_dt)
            data["published_at"] = datetime.strptime(raw_dt, "%d.%m.%Y %H:%M")
        except Exception:
            data["published_at"] = datetime.utcnow()

    # 3. Автор и ссылка на канал
    # Пример: Усть-Кут24 (https://telegram.me/UstKutNet) 👥 11 920
    auth_m = re.search(r'\n([^\n\(]+)\s*\((https?://[^\)]+)\)\s*👥', text)
    if auth_m:
        data["author_name"] = auth_m.group(1).strip()
        data["author_url"] = auth_m.group(2).strip()

    # 4. Текст поста (все после строки с автором и аудиторией)
    lines = text.split("\n")
    start_body = False
    body_lines = []
    for line in lines:
        if start_body:
            body_lines.append(line)
        elif "👥" in line:
            start_body = True

    data["snippet_text"] = "\n".join(body_lines).strip()
    return data
```
